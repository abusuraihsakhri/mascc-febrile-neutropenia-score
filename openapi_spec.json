{
  "openapi": "3.1.0",
  "info": {
    "title": "MASCC Febrile Neutropenia Score API",
    "version": "3.0.0",
    "description": "Reference summary. For authoritative schema use /openapi.json from FastAPI."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health status",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/api/score": {
      "post": {
        "summary": "Validated MASCC risk index (seven required criteria)",
        "description": "0–26 points; ≥21 indicates lower risk; not a disposition decision",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "burden": {
                    "enum": [
                      "none_mild",
                      "moderate",
                      "severe"
                    ]
                  },
                  "no_hypotension": {
                    "type": "boolean"
                  },
                  "no_copd": {
                    "type": "boolean"
                  },
                  "favorable_malignancy": {
                    "type": "boolean"
                  },
                  "no_dehydration": {
                    "type": "boolean"
                  },
                  "outpatient_onset": {
                    "type": "boolean"
                  },
                  "age_under_60": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "burden",
                  "no_hypotension",
                  "no_copd",
                  "favorable_malignancy",
                  "no_dehydration",
                  "outpatient_onset",
                  "age_under_60"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Legacy non-clinical audit demo",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Non-clinical mock responder",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "In-memory demonstration audit trail",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON demonstration counters",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    }
  }
}
